# https://developers.cloudflare.com/workers/static-assets/headers

/extension-credentials.html
  Content-Security-Policy: default-src 'none'; script-src chrome-extension:; script-src-attr 'none'; style-src 'unsafe-inline'; frame-src chrome-extension:; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'

# Next.js build assets - immutable, cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Public folder images - stable site assets, cache for 30 days
/*.svg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.ico
  Cache-Control: public, max-age=2592000

# Fonts - immutable, cache forever
/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
