{
  "name": "@knoww/mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local",
    "preview:markets": "node --experimental-strip-types scripts/preview-markets.mjs",
    "dev:oauth": "wrangler dev --env local --env-file .dev.vars --var MCP_AUTH_MODE:oauth-required",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "deploy": "wrangler versions upload --env=\"\" --strict",
    "deploy:first-production": "wrangler deploy --env=\"\" --strict",
    "deploy:promote": "wrangler versions deploy --env=\"\"",
    "deploy:status": "wrangler deployments status --env=\"\"",
    "deploy:rollback": "wrangler rollback --env=\"\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run && node --experimental-strip-types --test scripts/test-market-bridge.mjs",
    "test:market-bridge": "node --experimental-strip-types --test scripts/test-market-bridge.mjs",
    "cf-typegen": "node ./scripts/generate-worker-types.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@knoww/logger": "workspace:*",
    "@knoww/services": "workspace:*",
    "@knoww/shared-types": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "decimal.js": "catalog:",
    "jose": "6.2.12",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260910.1",
    "@types/node": "24.13.4",
    "typescript": "catalog:",
    "vitest": "^4.1.11",
    "wrangler": "4.130.0"
  }
}
